generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // URL untuk runtime aplikasi (menggunakan connection pooler)
  url       = env("DATABASE_URL") 
  // URL untuk migrasi (koneksi langsung)
  directUrl = env("DIRECT_URL") 
}
model AboutInfo {
  id           Int      @id @default(1) // Hanya akan ada satu baris, jadi ID-nya selalu 1
  orgName      String
  description  String   @db.Text
  vision       String   @db.Text
  mission      String[] // Array of strings untuk daftar misi
  activePeriod String
  structure    Json     // Tipe JSON untuk menyimpan array objek struktur

  updatedAt    DateTime @updatedAt
}

// Model untuk semua postingan (Artikel & Event)
model Post {
  id               Int      @id @default(autoincrement())
  title            String
  slug             String   @unique
  excerpt          String
  description      String   @db.Text // Tipe Text untuk konten yang panjang
  imageUrl         String
  href             String?
  date             DateTime @default(now())
  category         String   // "Artikel" atau "Event"
  tags             String[] // Array of strings
  featured         Boolean?

  // Field opsional spesifik untuk Artikel
  author           String?
  readTime         String?  // Contoh: "5"

  // Field opsional spesifik untuk Event
  location         String?
  eventStartDate   DateTime? 
  eventEndDate     DateTime? 
  price            String? 
  registrationLink String?

  // Timestamp otomatis
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Model untuk Anggota Organisasi
model Member {
  id            Int      @id @default(autoincrement())
  name          String
  nomorAnggota  String   @unique
  
  // Field opsional
  jurusan       String?
  nomorTelepon  String?
  status        String?  // "Aktif", "Alumni", atau "Non-aktif"
  avatarUrl     String?

  // Timestamp otomatis
  createdAt     DateTime @default(now())
}